{
  "manifest_version": 3,
  "name": "Tanseek Helper Tools",
  "version": "1.0.1",
  "description": "Customize invoice print layouts by hiding the VAT included column and summary line.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://tanseek.ae/manager/*/invoices/*/print*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "print.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
